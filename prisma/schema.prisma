generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(cuid())
  userNumber String   @unique
  userName   String
  email      String   @unique
  telp       String?
  password   String
  role       Role     @default(STAFF)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workOrders WorkOrder[]
  scans      LabelScan[] // TAMBAHKAN INI

  @@map("users")
}

model Warehouse {
  id          String       @id @default(cuid())
  whNumber    String       @unique
  whName      String
  whLocation  String?
  remarks     String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  storageBins StorageBin[]
  workOrders  WorkOrder[]

  @@map("warehouses")
}

model StorageBin {
  id          String        @id @default(cuid())
  binAddress  String        @unique
  category    AssetCategory
  remarks     String?
  warehouseId String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  asset       Asset?
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  workOrders  WorkOrder[]

  @@map("storage_bins")
}

model Supplier {
  id          String           @id @default(cuid())
  supNumber   String           @unique
  supName     String
  supCategory SupplierCategory @default(LOCAL)
  address     String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assets      Asset[]

  @@map("suppliers")
}

model Asset {
  id           String        @id @default(cuid())
  assetNumber  String        @unique
  assetName    String
  category     AssetCategory
  price        Decimal       @default(0)
  remarks      String?
  supplierId   String?
  storageBinId String?       @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  quantity     Int           @default(0)
  labels       AssetLabel[]
  storageBin   StorageBin?   @relation(fields: [storageBinId], references: [id])
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])
  workOrders   WorkOrder[]

  @@map("assets")
}

model WorkOrder {
  id           String          @id @default(cuid())
  woNumber     String          @unique
  type         WorkOrderType
  status       WorkOrderStatus @default(TODO)
  warehouseId  String
  storageBinId String
  assetId      String
  quantity     Int
  remarks      String?
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  labels       AssetLabel[]
  labelScans   LabelScan[]
  asset        Asset           @relation(fields: [assetId], references: [id])
  createdBy    User            @relation(fields: [createdById], references: [id])
  storageBin   StorageBin      @relation(fields: [storageBinId], references: [id])
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id])

  @@map("work_orders")
}

model AssetLabel {
  id          String      @id @default(cuid())
  labelCode   String      @unique
  assetId     String
  workOrderId String
  inboundAt   DateTime?
  outboundAt  DateTime?
  isOutbound  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  asset       Asset       @relation(fields: [assetId], references: [id])
  workOrder   WorkOrder   @relation(fields: [workOrderId], references: [id])
  scans       LabelScan[]

  @@map("asset_labels")
}

model LabelScan {
  id String @id @default(cuid())

  labelId String
  label   AssetLabel @relation(fields: [labelId], references: [id])

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])

  scannedById String
  scannedBy   User   @relation(fields: [scannedById], references: [id])

  scannedAt DateTime @default(now())

  @@map("label_scans")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum AssetCategory {
  SMALL_ASSET
  MEDIUM_ASSET
  LARGE_ASSET
}

enum SupplierCategory {
  LOCAL
  IMPORT
}

enum WorkOrderType {
  INBOUND
  OUTBOUND
}

enum WorkOrderStatus {
  TODO
  ON_PROGRESS
  DONE
}
